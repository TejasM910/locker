# Local Windows (non-Docker) defaults. Replace with your local MySQL credentials.
# URL-encode password symbols (for example, @ as %40).
DATABASE_URL=mysql+asyncmy://root:URL_ENCODED_MYSQL_PASSWORD@127.0.0.1:3306/locker?charset=utf8mb4
SYNC_DATABASE_URL=mysql+pymysql://root:URL_ENCODED_MYSQL_PASSWORD@127.0.0.1:3306/locker?charset=utf8mb4
# Razorpay Test Mode: Key ID and secrets are backend-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional Docker Compose settings. Set these only if using Docker.
MYSQL_USER=locker
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DOCKER_DATABASE_URL=
DOCKER_SYNC_DATABASE_URL=
# Configure the ngrok HTTPS URL in Razorpay Dashboard as:
# https://YOUR-NGROK-HOST/v1/webhooks/razorpay
